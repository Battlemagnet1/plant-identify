<?xml version="1.0" encoding="utf-8"?>
<!--
    自动备份排除规则（Android 11 / API 30 及以下使用）。

    与 res/xml/data_extraction_rules.xml 是一对：
      - Android 12+ 读 data_extraction_rules.xml
      - Android 11 及以下读本文件

    本应用 minSdk 26，两条路径都会走到，因此两份都要提供 ——
    只给其中一份的话，另一半设备上的备份策略就退回到系统默认
    （默认是「全部备份」），与 allowBackup="false" 的意图相悖。

    排除全部内容的理由见 data_extraction_rules.xml 的说明。
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
