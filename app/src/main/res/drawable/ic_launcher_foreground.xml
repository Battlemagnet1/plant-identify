<?xml version="1.0" encoding="utf-8"?>
<!--
    启动图标前景：一片叶子（矢量，无需位图资源）
    minSdk 26，全部设备均支持自适应图标，因此不需要额外的 PNG mipmap。
    前景内容控制在中央安全区内，避免被圆形/方形遮罩裁切。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 叶身 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,30 C76,40 78,64 54,78 C30,64 32,40 54,30 Z" />

    <!-- 主脉 -->
    <path
        android:pathData="M54,36 L54,74"
        android:strokeColor="#1B5E20"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

    <!-- 侧脉 -->
    <path
        android:pathData="M54,47 L43,55 M54,47 L65,55 M54,60 L44,67 M54,60 L64,67"
        android:strokeColor="#1B5E20"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

</vector>
